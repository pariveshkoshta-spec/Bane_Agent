{
  "name": "Bane Text-to-SQL Cloud Server",
  "image": "mcr.microsoft.com/devcontainers/python:3.10",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Bane Text-to-SQL API",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "postCreateCommand": "pip install --upgrade pip setuptools wheel && pip install -r requirements.txt && pip install -e .",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
